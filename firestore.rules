
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // User profiles
    match /database/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Customer orders
    match /{ownerId}/{orderId} {

      // Another user can claim an unclaimed order.
      function isClaim() {
        return resource.data.takenUp == 0
          && request.resource.data.takenUp == 1
          && request.resource.data.agent_id == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 "agent_id",
                 "orderList",
                 "cost",
                 "takenUp",
                 "agent_mobile"
               ]);
      }

      // Only the assigned agent can mark the order as delivered.
      function isDeliveryUpdate() {
        return resource.data.takenUp == 1
          && resource.data.agent_id == request.auth.uid
          && resource.data.delivered == 0
          && request.resource.data.delivered == 1
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["delivered"]);
      }

      allow read: if signedIn();

      allow create, delete: if signedIn()
        && request.auth.uid == ownerId;

      allow update: if signedIn()
        && (
          request.auth.uid == ownerId
          || isClaim()
          || isDeliveryUpdate()
        );
    }
  }
}